[gd_scene format=3]

[ext_resource type="Script" path="res://levels/level.gd" id="1_level"]
[ext_resource type="PackedScene" path="res://levels/garden/garden_theme.tscn" id="2_theme"]
[ext_resource type="PackedScene" path="res://src/objects/start_point.tscn" id="3_start"]
[ext_resource type="PackedScene" path="res://src/objects/ant_hill.tscn" id="4_hill"]
[ext_resource type="PackedScene" path="res://src/objects/garden/dirt_tile.tscn" id="5_dirt"]
[ext_resource type="PackedScene" path="res://src/objects/fall_zone.tscn" id="6_fall"]

; PLACEHOLDER LEVEL 5 -- an empty stand-in behind hub tunnel 5: a straight
; dirt strip from the start to an ant hill. Replace with a real "Inside the
; Nest" level (see SETUP_NOTES.md).
[node name="Level5Placeholder" type="Node3D"]
script = ExtResource("1_level")
level_name = "Placeholder 5"

[node name="GardenTheme" parent="." instance=ExtResource("2_theme")]
backdrop_enabled = false

[node name="StartPoint" parent="." instance=ExtResource("3_start")]
position = Vector3(0, 0, 20)

[node name="Strip" parent="." instance=ExtResource("5_dirt")]
position = Vector3(0, -0.5, 0)
size = Vector3(12, 1, 60)

[node name="AntHill" parent="." instance=ExtResource("4_hill")]
position = Vector3(0, 0, -20)

[node name="FallZone" parent="." instance=ExtResource("6_fall")]
position = Vector3(0, -8, 0)
