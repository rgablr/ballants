; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Ballants"
run/main_scene="res://levels/garden/title_meadow.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Tuning="*res://config/physics_tuning.gd"
Assets="*res://assets/asset_manifest.gd"
Game="*res://src/core/game.gd"
Sounds="*res://src/core/sound_hooks.gd"
Music="*res://src/core/music.gd"
Effects="*res://src/core/effects.gd"
Levels="*res://src/core/level_manager.gd"
Progress="*res://src/core/progress.gd"
Controls="*res://src/core/controls.gd"
Cosmetics="*res://src/core/cosmetics.gd"
Saves="*res://src/core/save_game.gd"
CustomizeMenu="*res://src/ui/customize_menu.gd"
Transition="*res://src/ui/transition.gd"
GameMenu="*res://src/ui/game_menu.gd"
DevTools="*res://src/core/dev_tools.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

